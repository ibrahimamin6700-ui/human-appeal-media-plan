<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="6dp">
    <LinearLayout android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/w_pill_white" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="7dp" android:paddingEnd="7dp">
        <ImageView android:id="@+id/w_avatar" android:layout_width="46dp" android:layout_height="46dp" android:scaleType="fitCenter" android:contentDescription="Alexandra"/>
        <TextView android:id="@+id/w_ask" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Ask Alexandra…" android:textColor="#1C3C96" android:textSize="16sp" android:textStyle="bold" android:maxLines="1"/>
        <FrameLayout android:id="@+id/w_mic" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/w_mic">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/w_ic_mic" android:contentDescription="Voice"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_c1" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/w_chip" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Today's numbers" android:textColor="#1C3C96" android:textSize="12.5sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_c2" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/w_chip" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Sheets &amp; links" android:textColor="#1C3C96" android:textSize="12.5sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_c3" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/w_chip" android:gravity="center" android:paddingStart="13dp" android:paddingEnd="13dp" android:text="Voice" android:textColor="#1C3C96" android:textSize="12.5sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
